.DS_Store
.env
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Kaggle data and generated model binaries can be large or sensitive.
data/raw/*.csv
data/raw/*.zip
data/processed/*
!data/processed/.gitkeep
artifacts/*.joblib

# Generated report assets.
reports/figures/*
!reports/figures/.gitkeep

# Kaggle credentials must stay outside the repository.
kaggle.json
